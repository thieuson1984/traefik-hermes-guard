# Hermes Guard — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# ---- Hermes Agent ----
HG_HERMES_ENDPOINT=
HG_HERMES_TOKEN=

# ---- Redis ----
HG_REDIS_ADDR=
HG_REDIS_PASSWORD=
HG_REDIS_DB=

# ---- Plugin Mode ----
# "monitor" = log & report only, never block
# "protect" = block based on risk score & AI verdicts
HG_MODE=

# ---- Logging ----
# "debug" | "info" | "warn" | "error"
HG_LOG_LEVEL=

# ---- Detection Tuning ----
HG_MIN_RISK_SCORE=
HG_CACHE_TTL=
HG_MAX_BODY_SIZE=

# ---- Challenge (used when Hermes returns "challenge" verdict) ----
HG_CHALLENGE_URL=

# ---- Cloudflare Turnstile (CAPTCHA) ----
# Get keys from https://dash.cloudflare.com/ → Turnstile
HG_TURNSTILE_SITE_KEY=
HG_TURNSTILE_SECRET_KEY=

# ---- Notifications ----
HG_WEBHOOK_URL=
HG_HERMES_BLOCK_WEBHOOK_SECRET=
HG_ADMIN_SECRET=

# ---- Rate Limiting ----
HG_RATE_LIMIT_REQS=
HG_RATE_LIMIT_WINDOW=
