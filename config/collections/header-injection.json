{"category":"header-injection","description":"HTTP Header Injection / CRLF / Response Splitting","patterns":[{"name":"Header Injection — CRLF","pattern":"(?i)(%0[ad]|\\\\r\\\\n|\\r\\n|%0d%0a)","severity":"high"},{"name":"Header Injection — Raw Newline","pattern":"(?i)(\\n\\s*(?:Content-Type|Location|Set-Cookie|X-|Cache-Control):)","severity":"critical"},{"name":"Header Injection — Host header","pattern":"(?i)(\\n\\s*Host:\\s*[\\w.]+)","severity":"high"},{"name":"Header Injection — Encoded CRLF","pattern":"(?i)(%250[ad]|%250d%250a|%%0d%%0a)","severity":"medium"}]}
