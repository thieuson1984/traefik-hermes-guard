{"category":"http-smuggling","description":"HTTP Request Smuggling patterns","patterns":[{"name":"HTTP Smuggling — CL.TE","pattern":"(?i)(Content-Length:\\s*\\d+.*Transfer-Encoding:\\s*chunked)","severity":"critical"},{"name":"HTTP Smuggling — TE.CL","pattern":"(?i)(Transfer-Encoding:\\s*chunked.*Content-Length:\\s*0)","severity":"critical"},{"name":"HTTP Smuggling — TE.TE","pattern":"(?i)(Transfer-Encoding:\\s*[\\w, ]+\\r?\\nTransfer-Encoding:)","severity":"critical"},{"name":"HTTP Smuggling — Hop-by-hop","pattern":"(?i)(Connection:\\s*(?:close|keep-alive|transfer-encoding|upgrade))","severity":"medium"}]}
