{"category":"csrf","description":"Cross-Site Request Forgery patterns","patterns":[{"name":"CSRF — Missing Origin","pattern":"(?i)(POST|PUT|DELETE|PATCH)","severity":"low"},{"name":"CSRF — Cross-origin without token","pattern":"(?i)(Origin:\\s*https?://(?:[\\w.-]+)\r?\n.*?(?:csrf|token|authenticity_token)\\s*[:=]\\s*$|no CSRF token)","severity":"medium"},{"name":"CSRF — CORS wildcard with credentials","pattern":"(?i)(Access-Control-Allow-Origin:\\s*\\*.*Access-Control-Allow-Credentials:\\s*true)","severity":"medium"}]}
