{"category":"file-upload","description":"Malicious file upload patterns","patterns":[{"name":"File Upload — PHP double extension","pattern":"(?i)(\\.php[\\d]?\\.|\\.phtml\\.|\\.php[3-7]\\.|\\.phar\\.)","severity":"critical"},{"name":"File Upload — Executable","pattern":"(?i)(\\.(?:exe|dll|bat|sh|py|pl|jar|war|jsp|asp|aspx|cgi)\\.)","severity":"high"},{"name":"File Upload — Polyglot","pattern":"(?i)(filename=.*\\.(?:php|jsp|asp).*Content-Type:\\s*(?:image|text))","severity":"high"},{"name":"File Upload — Null byte injection","pattern":"(?i)(\\.(?:php|jsp|asp)%.*%00|\\.(?:php|jsp|asp)\\x00)","severity":"critical"}]}
