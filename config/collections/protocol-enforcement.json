{
  "category": "protocol-enforcement",
  "description": "OWASP CRS — 920-PROTOCOL-ENFORCEMENT",
  "patterns": [
    {
      "name": "GET or HEAD Request with Body Content",
      "pattern": "^(?:GET|HEAD)$",
      "severity": "critical"
    },
    {
      "name": "Range: Invalid Last Byte Value",
      "pattern": "(\\d+)-(\\d+)",
      "severity": "medium"
    },
    {
      "name": "Multiple/Conflicting Connection Header Data Found",
      "pattern": "\\b(?:keep-alive|close),\\s?(?:keep-alive|close)\\b",
      "severity": "medium"
    },
    {
      "name": "Unicode Full/Half Width Abuse Attack Attempt",
      "pattern": "(?i)%uff[0-9a-f]{2}",
      "severity": "medium"
    },
    {
      "name": "Empty Host Header",
      "pattern": "^$",
      "severity": "critical"
    },
    {
      "name": "Host header is a numeric IP address",
      "pattern": "(?:^([\\d.]+|\\[[\\da-f:]+\\]|[\\da-f:]+)(:[\\d]+)?$)",
      "severity": "medium"
    },
    {
      "name": "Request content type is not allowed by policy",
      "pattern": "(?i)^[^;\\s]+",
      "severity": "critical"
    },
    {
      "name": "Request content type charset is not allowed by policy",
      "pattern": "(?i)charset\\s*=\\s*[\\\"']?([^;\\\"'\\s]+)",
      "severity": "critical"
    },
    {
      "name": "Multiple charsets detected in content type header",
      "pattern": "(?i)charset.*?charset",
      "severity": "critical"
    },
    {
      "name": "URL file extension is restricted by policy",
      "pattern": "\\.([^.]+)$",
      "severity": "critical"
    },
    {
      "name": "Attempt to access a backup or working file",
      "pattern": "(?i)\\.[^.~]+~(?:/.*|)$",
      "severity": "critical"
    },
    {
      "name": "HTTP header is restricted by policy (%{MATCHED_VAR})",
      "pattern": "(?i)^.*$",
      "severity": "critical"
    },
    {
      "name": "Possible Unicode character bypass detected",
      "pattern": "(?i)\\x5cu[0-9a-f]{4}",
      "severity": "critical"
    },
    {
      "name": "Range: Too many fields (6 or more)",
      "pattern": "^bytes=(?:(?:\\d+)?-(?:\\d+)?\\s*,?\\s*){6}",
      "severity": "medium"
    },
    {
      "name": "CRS-",
      "pattern": "^bytes=(?:(?:\\d+)?-(?:\\d+)?\\s*,?\\s*){63}",
      "severity": "medium"
    },
    {
      "name": "Multiple URL Encoding Detected",
      "pattern": "%[0-9a-fA-F]{2}",
      "severity": "medium"
    },
    {
      "name": "Attempted multipart/form-data bypass",
      "pattern": "['\\\";=\\x5c]",
      "severity": "critical"
    },
    {
      "name": "CRS-",
      "pattern": "\\x25",
      "severity": "medium"
    },
    {
      "name": "CRS-",
      "pattern": "(?i)^[a-z]{3,10}$",
      "severity": "medium"
    },
    {
      "name": "CRS-",
      "pattern": "^(?i)up",
      "severity": "medium"
    },
    {
      "name": "CRS-",
      "pattern": "(?i)^bytes=(?:(?:\\d+)?-(?:\\d+)?\\s*,?\\s*){6}",
      "severity": "medium"
    },
    {
      "name": "Abnormal character escapes in request",
      "pattern": "(?i)(?:^|[^\\x5c])\\x5c[cdeghijklmpqwxyz123456789]",
      "severity": "critical"
    }
  ],
  "source": "https://github.com/coreruleset/coreruleset/blob/main/rules/REQUEST-920-PROTOCOL-ENFORCEMENT.conf"
}